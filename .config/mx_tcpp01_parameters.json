{
  "componentid": "::Board Part:STM32CubeMX2 Config:TCPP01",
  "type": "object",
  "grammarVersion": "3.8.0",
  "license": "Copyright (c) 2026 STMicroelectronics",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "TCPP01 configuration",
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "SW Label for parts objects",
              "description": "Labels allow to create aliases inside mx_tcpp01.h file for the object ID and object getter function. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "interface": {
              "title": "Interface selection",
              "description": "Select the Interface to be configured",
              "type": "string",
              "oneOf": [
                {
                  "const": "ADC_EXTI",
                  "title": "ADC_EXTI"
                },
                {
                  "const": "Custom",
                  "title": "Custom"
                }
              ],
              "default": "ADC_EXTI"
            }
          }
        },
        "resourcesAllocation": {
          "title": "STM32 resources allocation",
          "type": "object",
          "properties": {
            "adcExtiIoCfg": {
              "type": "object",
              "description": "ADC Interface and handles type-c cable detection using the EXTI driver.",
              "title": "ADC EXTI Interface Configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$info.interface === 'ADC_EXTI'"
                }
              ],
              "properties": {
                "adcInstance": {
                  "type": "object",
                  "title": "ADC Instance",
                  "description": "The ADC peripheral must be configured first in the HAL ADC configuration panel",
                  "objectType": "bind.peripheral.config",
                  "criteria": {
                    "peripheralType": [
                      "adc"
                    ]
                  },
                  "actions": [
                    {
                      "type": "error",
                      "condition": "!$resourcesAllocation.adcExtiIoCfg.adcInstance?.selection",
                      "message": "Please select an ADC instance configured in the Peripheral configuration panel."
                    }
                  ]
                },
                "Ra": {
                  "title": "VBUS voltage divider RA in Ohm",
                  "type": "integer",
                  "unit": "Ohm",
                  "default": 330000
                },
                "Rb": {
                  "title": "VBUS voltage divider RB in Ohm",
                  "type": "integer",
                  "unit": "Ohm",
                  "default": 49900
                },
                "Vdd": {
                  "title": "Value of VDD in mV ",
                  "type": "integer",
                  "unit": "mV",
                  "default": 3300
                },
                "dbCfg": {
                  "title": "Dead Battery Configuration",
                  "type": "object",
                  "objectType": "bind.gpio.config",
                  "description": "The GPIO pin must be configured as an output in the HAL GPIO configuration panel",
                  "pins": {
                    "dbpin": {
                      "title": "Dead Battery PIN"
                    }
                  },
                  "actions": [
                    {
                      "type": "error",
                      "condition": "!$resourcesAllocation.adcExtiIoCfg.dbCfg?.selection",
                      "message": "Please select a GPIO pin configured as an output in the HAL GPIO configuration panel."
                    }
                  ]
                },
                "extiCfg": {
                  "title": "EXTI Configuration",
                  "type": "object",
                  "objectType": "bind.gpio.config",
                  "description": "The GPIO pin must be configured as an external trigger (EXTI) in the HAL GPIO configuration panel",
                  "pins": {
                    "extipin": {
                      "title": "EXTI PIN",
                      "constraints": {
                        "mode": {
                          "const": "input"
                        }
                      }
                    }
                  },
                  "actions": [
                    {
                      "type": "error",
                      "condition": "!$resourcesAllocation.adcExtiIoCfg.extiCfg?.selection",
                      "message": "Please select a GPIO pin configured as an external trigger (EXTI) in the HAL GPIO configuration panel."
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
